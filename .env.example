# ---- backend (backend/.env locally; Render dashboard in production) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
SPHEREX_COLLECTIONS=spherex_dr1,spherex_qr3
MAX_EXPOSURES=240
CUTOUT_CONCURRENCY=8
CACHE_DIR=./cache
DB_PATH=./data/astra.sqlite3
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app
SIMBAD_TAP_URLS=https://simbad.harvard.edu/simbad/sim-tap/sync,https://simbad.cds.unistra.fr/simbad/sim-tap/sync
GAIA_TAP_URL=https://gea.esac.esa.int/tap-server/tap/sync
# ---- frontend (frontend/.env.local; Vercel project env) ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
